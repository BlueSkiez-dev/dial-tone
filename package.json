{
  "name": "dial-tone-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:props": "vitest run prop.test",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.65.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "preact-render-to-string": "6.8.3",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-window": "7.4.1"
  },
  "dependencies": {
    "preact": "11.2.0"
  }
}
