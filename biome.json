{
  "files": {
    "includes": [
      "src/**",
      "*.json",
      "*.ts",
      "!**/node_modules",
      "!**/dist",
      "!dev-dist",
      "!public",
      "!**/coverage",
      "!vendor",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true
  }
}
